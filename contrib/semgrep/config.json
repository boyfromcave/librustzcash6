{
  "_comment": "Semgrep scan policy for this fork of librustzcash (contrib/semgrep/README.md). The same keys as ycash-dd and ycash6; rule_paths, exclude_rules and the path lists are this repository's own.",
  "semgrep_version": "1.179.0",
  "rules_repo": "https://github.com/semgrep/semgrep-rules",
  "rules_commit": "16b9e6d45f10649f6a531ec4838ed9924372c3bc",
  "rule_paths": [
    "rust",
    "python/lang/security",
    "generic/secrets",
    "yaml/github-actions"
  ],
  "local_rules": "contrib/semgrep/rules",
  "categories": ["security"],
  "exclude_rules": {},
  "non_production_paths": [
    "**/tests/**",
    "*/tests.rs",
    "*/test_vectors*",
    "*/testing.rs",
    "**/testing/**",
    "**/benches/**",
    "**/examples/**",
    "**/proptest-regressions/**",
    ".github/helpers/**",
    "contrib/**",
    "*.md"
  ],
  "buckets": {
    "critical": {"sla_days": 7,   "color": "b60205", "label": "semgrep:critical"},
    "high":     {"sla_days": 30,  "color": "d93f0b", "label": "semgrep:high"},
    "medium":   {"sla_days": 90,  "color": "fbca04", "label": "semgrep:medium"},
    "low":      {"sla_days": 180, "color": "0e8a16", "label": "semgrep:low"}
  },
  "autofix_rules": [],
  "autofix_never_paths": [
    "components/zcash_protocol/**",
    "components/equihash/**",
    "components/zcash_encoding/**",
    "zcash_primitives/**",
    "zcash_transparent/**",
    "zcash_proofs/**",
    "zcash_history/**"
  ],
  "fail_on": ["critical"],
  "base_branch": "upgrade/vault",
  "branch_prefix": "semgrep/",
  "pr_labels": ["security", "semgrep"],
  "overdue_label": "sla:overdue"
}
